<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>RPChronicles</AssemblyName>
    <Product>Afterword</Product>
    <Version>0.1.6.0</Version>
    <Description>Record roleplay scenes from /say and emotes, then reopen them in a private notebook.</Description>
    <Authors>Afterword</Authors>
    <Author>Afterword</Author>
    <Name>Afterword</Name>
    <Punchline>A private notebook for roleplay scenes.</Punchline>
    <DalamudApiLevel>15</DalamudApiLevel>
    <ApplicableVersion>any</ApplicableVersion>
    <Tags>roleplay,notebook</Tags>
    <AcceptsFeedback>false</AcceptsFeedback>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="RPChronicles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\afterword-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="images\icon.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="images\image1.png">
      <Link>images\image1.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
